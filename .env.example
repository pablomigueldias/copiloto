# Copie para .env e ajuste. O .env NÃO vai pro git.

# ── Banco ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://copiloto:copiloto_dev@localhost:5434/copiloto
DB_ECHO=false

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo

# ── Observabilidade ───────────────────────────────────────────────
# store_payloads=false grava só métricas (sem prompt/resposta).
OBSERVER_ENABLED=true
OBSERV_STORE_PAYLOADS=true

# ── LLM (Fase 1) ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_REDACAO=qwen3:4b
OLLAMA_MODEL_ANALISE=qwen3:8b
OLLAMA_MODEL_EMBEDDING=bge-m3

# ── Sessão ────────────────────────────────────────────────────────
# Em dev sobre http puro precisa ser false (o browser rejeita __Host-/Secure).
SESSION_COOKIE_SECURE=false
SESSION_DIAS_ABSOLUTO=7
SESSION_HORAS_INATIVIDADE=24

# ── Seed do admin (scripts/seed_admin.py) ─────────────────────────
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# ── CORS (front Next) ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Testes ────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+asyncpg://copiloto:copiloto_dev@localhost:5434/copiloto_test
