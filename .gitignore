# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Ambiente
.env

# Planejamento — mora aqui para o indexador ler (CONHECIMENTO_FONTES), mas é
# material pessoal e fica fora do repositório.
docs/

# Runtime
logs/
# `data/*` e não `data/`: o git não desfaz o ignore de um arquivo dentro de uma
# pasta ignorada, e o glossário precisa entrar. Ele não é dado pessoal — é a
# tabela que corrige o que o Whisper erra, e é o motivo de a transcrição
# melhorar com o uso. Perder o arquivo apaga esse aprendizado.
data/*
!data/glossario.json
# O acervo de questões é conteúdo conferido à mão contra o gabarito oficial —
# 16 questões que custaram uma varredura de 14 provas em PDF. Dado de runtime
# se refaz; isto não.
!data/estudo/
!data/estudo/*.json

# Ferramentas
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node — o front tem o próprio `web/.gitignore`, gerado pelo `create-next-app`
# e mantido lá para o padrão do ecossistema continuar valendo. Aqui fica só a
# rede contra um `npm install` disparado na raiz por engano.
node_modules/
